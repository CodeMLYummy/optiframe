# Large binaries in Git LFS (install: https://git-lfs.com, then `git lfs install`).
# frontend/ and backend/ stay in plain git: Cloud Build checks out without LFS, and the app
# serves frontend/public/ (icons, sheet PDFs) as-is.
consignes.pdf filter=lfs diff=lfs merge=lfs -text
training/sheets/*.pdf filter=lfs diff=lfs merge=lfs -text
lensDetection/**/*.jpg filter=lfs diff=lfs merge=lfs -text
lensDetection/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
lensDetection/**/*.png filter=lfs diff=lfs merge=lfs -text
lensDetection/**/*.heic filter=lfs diff=lfs merge=lfs -text
