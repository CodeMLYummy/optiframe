# Editor configuration for the whole repo, see https://editorconfig.org (frontend/ has its own, same rules).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4

[{pom.xml,eclipse-formatter.xml}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Shell (shfmt reads these): 2 spaces, indented case branches. The hooks have no extension.
[{*.sh,.githooks/*}]
indent_size = 2
switch_case_indent = true
